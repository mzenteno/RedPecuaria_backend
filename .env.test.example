# Plantilla para verificar CRUDs de punta a punta (crear/editar/eliminar) sin
# escribir datos de prueba en la base real de desarrollo (.env / DB_NAME=RedPecuaria).
#
# Uso: copiar los valores acá abajo como variables de entorno del shell antes
# de levantar el servidor — NO como un archivo ".env.test" que Nest cargue
# solo (ConfigModule.forRoot en app.module.ts siempre lee ".env", sin
# importar NODE_ENV). dotenv no pisa una variable ya seteada en el entorno,
# así que esto gana sobre lo que diga ".env":
#
#   DB_NAME=RedPecuariaTest PORT=3011 npm run start:dev
#
# Levanta un backend efímero en un puerto distinto al que ya estés usando
# (3010), apuntando a una base separada — matarlo por PID exacto al terminar,
# nunca el proceso real. La base "RedPecuariaTest" debe existir y tener las
# migraciones corridas (mismo comando de arriba, con "migration:run" en vez
# de "start:dev"). Ver ARCHITECTURE.md §8.

PORT=3011

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=RedPecuariaTest
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
CORS_ORIGIN=*
