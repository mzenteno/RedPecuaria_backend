PORT=3010

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=RedPecuaria
DB_SYNCHRONIZE=false
# true solo contra Postgres administrado (Neon, Render, Supabase, etc.) —
# exigen SSL. En local, dejar en false.
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
CORS_ORIGIN=*

# Base pública de ESTA API — para armar URLs absolutas de archivos que ella
# misma sirve (ej. el logo de una empresa, ver `LocalFileStorageAdapter`).
# Una ruta relativa ahí resolvería contra el origen del FRONTEND, no el de
# esta API (dominios distintos).
APP_BASE_URL=http://localhost:3010
