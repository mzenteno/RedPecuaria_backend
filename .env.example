PORT=3010

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=RedPecuaria
DB_SYNCHRONIZE=false
# true solo contra Postgres administrado (Neon, Render, Supabase, etc.) —
# exigen SSL. En local, dejar en false.
DB_SSL=false

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_DAYS=30
CORS_ORIGIN=*
